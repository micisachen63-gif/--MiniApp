/* v0.5 battle animation layer (battle.js). Only transform/opacity animate; filters/masks are static per element. */
.bstage{position:relative;height:236px;overflow:hidden;border-radius:16px;border:1px solid var(--line);margin-bottom:12px;background:#0b1020;contain:layout paint;isolation:isolate;user-select:none;-webkit-user-select:none}
.bstage .world{position:absolute;inset:0;will-change:transform}
.bstage .bg{position:absolute;inset:-4%;background:#1c2540 center 88%/cover no-repeat}
.bstage .bg::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.05) 55%,rgba(0,0,0,.35))}
.bstage .fighter{position:absolute;bottom:5%;will-change:transform;z-index:2}
.bstage .hero{left:3%;height:80%}
.bstage[data-cls="archer"] .hero{left:calc(24% - 19px)}
.bstage .mon{right:5%;height:54%;transition:opacity .35s}
.bstage .mon.elite{height:64%}
.bstage .mon.boss{height:74%}
.bstage .fighter .bob{height:100%;animation:b-bob 2.6s ease-in-out infinite;transform-origin:50% 100%}
.bstage .mon .bob{animation-duration:2.1s;animation-delay:-.7s}
.bstage .fighter .act{height:100%;position:relative;transform-origin:50% 100%}
.bstage .fighter img{height:100%;width:auto;display:block;filter:drop-shadow(0 4px 3px rgba(0,0,0,.5));-webkit-user-drag:none;pointer-events:none}
.bstage .hero .hero-sheet{display:none;position:absolute;top:0;background-repeat:no-repeat;filter:drop-shadow(0 4px 3px rgba(0,0,0,.5));pointer-events:none}
.bstage .hero.hero-sheet-active .hero-sheet{display:block}
.bstage .hero.hero-sheet-active .act>img{visibility:hidden}
.bstage[data-cls="mage"] .hero .act>img:not(.cape){transform:scaleX(-1)}
.bstage[data-cls="mage"] .hero img.cape{display:none}
.bstage[data-cls="mage"] .hero .tint{transform:scaleX(-1)}
.bstage .hero.hero-action-active[data-action="hero-sword-action"]{animation:b-hero-sword var(--action-duration,330ms) ease-out both;transform-origin:50% 100%}
.bstage .hero.hero-action-active[data-action="hero-archer-action"]{animation:b-hero-archer var(--action-duration,300ms) ease-out both;transform-origin:50% 100%}
.bstage .hero.hero-action-active[data-action="hero-mage-action"]{animation:b-hero-mage var(--action-duration,420ms) ease-in-out both;transform-origin:50% 100%}
.bstage.rm .hero.hero-action-active{animation:none!important}
.bstage .mon .sheet{display:none;position:absolute;inset:0;background-position:100% 100%;background-repeat:no-repeat;background-size:500% 200%;filter:drop-shadow(0 4px 3px rgba(0,0,0,.5));pointer-events:none}
.bstage .mon.sheet-ready .sheet{display:block;animation:b-sheet-idle 1.35s steps(1,end) infinite}
.bstage .mon.sheet-single-idle.sheet-ready .sheet:not(.attack){animation:none;background-position:100% 100%}
.bstage .mon.sheet-ready .act>img:first-child{visibility:hidden}
.bstage .mon.sheet-ready .tint{display:none}
.bstage .mon .sheet.attack{animation:b-sheet-attack .9s steps(1,end) both}
.bstage .hero .tint{position:absolute;inset:0;opacity:0;-webkit-mask:var(--m) center/100% 100% no-repeat;mask:var(--m) center/100% 100% no-repeat;pointer-events:none}
.bstage .hero .tint:not(.flash):not(.glow):not(.aura){display:none}
.bstage .mon .tint{position:absolute;inset:0;opacity:0;-webkit-mask:var(--m) center/100% 100% no-repeat;mask:var(--m) center/100% 100% no-repeat;pointer-events:none}
.bstage .tint.w{background:#fff}.bstage .tint.r{background:#ff2a2a}.bstage .tint.g{background:#57ff8a}.bstage .tint.b{background:#5fb4ff}.bstage .tint.k{background:#ffd76a}
.bstage .shadow{position:absolute;bottom:-5px;left:18%;right:18%;height:12px;border-radius:50%;background:radial-gradient(closest-side,rgba(0,0,0,.5),transparent);z-index:-1}
.bstage .mon.elite img{filter:drop-shadow(0 0 6px rgba(255,60,40,.85)) drop-shadow(0 4px 3px rgba(0,0,0,.5))}
.bstage .mhp{position:absolute;left:50%;top:-14px;width:64px;margin-left:-32px;height:6px;border-radius:3px;background:rgba(0,0,0,.55);overflow:hidden;border:1px solid rgba(255,255,255,.25)}
.bstage .mhp i{position:absolute;inset:0;background:linear-gradient(90deg,#c01f2f,#ff5a5a);transform-origin:0 50%;transition:transform .25s ease-out}
.bstage .mon.elite .mhp i{background:linear-gradient(90deg,#d04a10,#ffa040)}
.bstage .mname{position:absolute;left:50%;top:-30px;transform:translateX(-50%);white-space:nowrap;font-size:11px;font-weight:800;color:#fff;text-shadow:0 1px 2px #000}
.bstage .hbars{position:absolute;left:8px;bottom:8px;width:92px;z-index:4}
.bstage .hbars div{height:6px;border-radius:3px;background:rgba(0,0,0,.6);margin-top:3px;overflow:hidden;border:1px solid rgba(255,255,255,.2)}
.bstage .hbars i{display:block;height:100%;transform-origin:0 50%;transition:transform .35s ease-out}
.bstage .hbars .h i{background:linear-gradient(90deg,#b8263a,#ff5a6a)}.bstage .hbars .m i{background:linear-gradient(90deg,#1f5fd1,#5fb4ff)}
.bstage canvas.fx{position:absolute;inset:0;width:100%;height:100%;z-index:3;pointer-events:none}
.bstage .floats{position:absolute;inset:0;z-index:5;pointer-events:none}
.bstage .fl{position:absolute;transform:translate(-50%,0);font:900 18px/1 var(--f-num,Cinzel),sans-serif;color:#ffe066;text-shadow:0 2px 0 #000,0 0 3px #000;white-space:nowrap;animation:b-float 1.05s ease-out forwards;will-change:transform,opacity}
.bstage .fl.crit{font-size:28px;color:#ffc93a;animation-name:b-crit}.bstage .fl.miss{color:#d8e2ff;font-size:16px}
.bstage .fl.hurt{color:#ff6b6b;font-size:17px}.bstage .fl.heal{color:#6dff9a}.bstage .fl.mana{color:#8fd0ff}
.bstage .fl.skill{color:#bfe6ff;font-size:14px;letter-spacing:1px;background:rgba(20,30,60,.65);padding:3px 8px;border-radius:8px;border:1px solid rgba(160,210,255,.6);animation-name:b-label}
.bstage .fl.exp{color:#9dff7a;font-size:14px}.bstage .fl.gold{color:#ffd34d;font-size:14px}.bstage .fl.loss{color:#ff8a8a;font-size:15px}
.bstage .fl.relic{font-size:15px;color:#fff;background:linear-gradient(90deg,#6b2bd0,#c99a2e);padding:4px 10px;border-radius:8px;border:1px solid #ffe7a0;animation-name:b-label;animation-duration:2.2s}
.bstage .lvup{position:absolute;left:50%;top:30%;z-index:6;transform:translate(-50%,-50%);font:900 30px/1 var(--f-num,Cinzel),serif;color:#ffe9a6;letter-spacing:3px;text-shadow:0 0 12px #ffb300,0 3px 0 #6b4400;opacity:0;pointer-events:none}
.bstage .lvup.on{animation:b-lvup 2.1s ease-out forwards}
.bstage .ring{position:absolute;width:150px;height:150px;margin:-75px 0 0 -75px;border-radius:50%;background:radial-gradient(closest-side,rgba(255,230,140,.9),rgba(255,190,40,.45) 55%,transparent);opacity:0;z-index:1;pointer-events:none}
.bstage .ring.on{animation:b-ring 1.4s ease-out forwards}
.bstage .bagi{position:absolute;right:8px;bottom:8px;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font-size:18px;background:radial-gradient(circle at 40% 35%,#5a4523,#1d140a);border:2px solid #c9a24a;z-index:6}
.bstage .bagi.bump{animation:b-bump .35s ease-out}
.bstage .loot{position:absolute;width:30px;height:30px;z-index:6;pointer-events:none;will-change:transform,opacity}
.bstage .loot img{width:100%;height:100%;filter:drop-shadow(0 0 4px rgba(255,220,120,.9))}
.bstage .hint{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);z-index:6;background:rgba(20,14,8,.85);border:1.5px solid #c9a24a;color:#f6e3a8;font-size:12px;font-weight:800;padding:6px 10px;border-radius:8px;white-space:nowrap;display:none}
.bstage.stalled .hint{display:block}
.bstage .status{position:absolute;left:10px;top:10px;z-index:6;padding:5px 10px;border-radius:10px;background:rgba(0,0,0,.55);color:#fff;font-size:13px;font-weight:700}
.bstage .status.warn{background:rgba(190,40,40,.85)}.bstage .status.gate{background:rgba(120,70,220,.85)}
.bstage .mapname{position:absolute;right:10px;top:10px;z-index:6;padding:4px 9px;border-radius:10px;background:rgba(0,0,0,.45);color:#fff;font-size:12px}
/* actions (class names toggled on .act / .world) */
.bstage .act.lunge{animation:b-lunge .52s cubic-bezier(.3,.7,.3,1)}
.bstage .act.recoil{animation:b-recoil .5s ease-out}
.bstage .act.raise{animation:b-raise .62s ease-in-out}
.bstage .act.knock{animation:b-knock .32s ease-out}
.bstage .act.mlunge{animation:b-mlunge .48s cubic-bezier(.3,.7,.3,1)}
.bstage .act.hit{animation:b-hit .3s ease-out}
.bstage .act.die{animation:b-die .7s ease-in forwards}
.bstage .act.spawn{animation:b-spawn .55s ease-out}
.bstage .tint.flash{animation:b-flash .26s ease-out}
.bstage .tint.glow{animation:b-glow .9s ease-out}
.bstage .world.shake{animation:b-shake .32s linear}
.bstage .hero.down .act{transition:transform .7s cubic-bezier(.5,0,.8,.6);transform:translate(10%,4%) rotate(-82deg)}
.bstage .hero.down img,.bstage .hero.slump img{filter:grayscale(1) brightness(.7) drop-shadow(0 4px 3px rgba(0,0,0,.5))}
.bstage .hero.slump .act{transition:transform .6s ease;transform:translateY(5%) rotate(5deg) scaleY(.93)}
.bstage .hero.down .bob,.bstage .hero.slump .bob{animation:none}
.bstage.paused *,.bstage.paused *::before,.bstage.paused *::after{animation-play-state:paused!important}
@keyframes b-bob{50%{transform:translateY(-1.6%) scaleY(1.012)}}
