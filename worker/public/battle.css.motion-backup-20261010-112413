/* reduced motion: no movement, only short fades */
.bstage.rm .fighter .bob{animation:none}
.bstage.rm .mon.sheet-ready .sheet{animation:none!important;background-position:100% 100%!important}
.bstage.rm .act.lunge,.bstage.rm .act.recoil,.bstage.rm .act.raise,.bstage.rm .act.knock,.bstage.rm .act.mlunge,.bstage.rm .act.hit,.bstage.rm .act.spawn,.bstage.rm .world.shake{animation:none}
.bstage.rm .act.die{animation:b-fadeout .5s forwards}
.bstage.rm .fl,.bstage.rm .fl.crit,.bstage.rm .fl.skill,.bstage.rm .fl.relic{animation:b-fadeonly 1.2s forwards}
.bstage.rm .lvup.on{animation:b-fadeonly 2s forwards}
@keyframes b-fadeout{to{opacity:0}}@keyframes b-fadeonly{0%,70%{opacity:1}100%{opacity:0}}
body.greek .bstage{border:3px solid var(--g-gold);border-radius:6px;box-shadow:inset 0 0 0 2px #2b2118,0 8px 18px rgba(0,0,0,.5)}
body.greek .bstage .status,body.greek .bstage .mapname{background:rgba(26,18,11,.85);border:1.5px solid var(--g-gold);border-radius:4px;color:var(--g-gold-l);font-family:var(--f-ui,"Noto Serif TC"),serif}
body.greek .bstage .status.warn{background:rgba(106,31,43,.92)}body.greek .bstage .status.gate{background:rgba(27,42,78,.92)}

/* ---- v0.5 natural motion ---- */
.bstage .fighter .bob{animation:b-breathe 2.8s ease-in-out infinite}
.bstage .mon .bob{animation:b-bob 2.1s ease-in-out infinite;animation-delay:-.7s}
/* cape / hair layer: the back third of the figure, top-anchored, sways a little (skew) */
.bstage .hero img.cape{position:absolute;left:0;top:0;filter:none;transform-origin:50% 22%;animation:b-cape 3.4s ease-in-out infinite;
  -webkit-mask:linear-gradient(90deg,#000 0,#000 var(--c0,30%),transparent var(--c1,46%)),linear-gradient(180deg,transparent 0,transparent 18%,#000 30%);-webkit-mask-composite:source-in;
  mask:linear-gradient(90deg,#000 0,#000 var(--c0,30%),transparent var(--c1,46%)) intersect,linear-gradient(180deg,transparent 0,transparent 18%,#000 30%);mask-composite:intersect}
.bstage .act.slash{animation:b-slash calc(var(--d,1)*.78s) cubic-bezier(.3,.6,.3,1)}
.bstage .act.bash{animation:b-bash calc(var(--d,1)*.74s) cubic-bezier(.3,.6,.3,1)}
.bstage .act.draw{animation:b-draw var(--action-duration,650ms) ease-out both}
.bstage .hero .bow-fx{display:none!important}
.bstage .hero[data-action="hero-archer-action"] .bow-fx{display:none!important}
.bstage .hero .bow-fx svg{width:100%;height:100%;overflow:visible}
.bstage .hero .bow-fx .bowstring,.bstage .hero .bow-fx .bowstring-pull{fill:none;stroke:#fff0ae;stroke-width:2.4;stroke-linecap:round;filter:drop-shadow(0 0 3px #ffbd42)}
.bstage .hero .bow-fx .bowstring-pull{stroke:#fff;stroke-width:3;opacity:0;animation:b-bowstring var(--action-duration,650ms) ease-out both}
.bstage .hero .bow-fx .bow-arrow{fill:none;stroke:#ffe6a0;stroke-width:3.2;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 0 5px #ffb82e);transform-box:fill-box;transform-origin:50% 50%;animation:b-bow-arrow var(--action-duration,650ms) ease-out both}
.bstage .act.channel{animation:b-channel var(--action-duration,420ms) ease-in forwards}
.bstage .hero .staff-fx{display:none;position:absolute;left:0;top:0;width:100%;height:100%;z-index:5;pointer-events:none;overflow:visible}
.bstage[data-cls="mage"] .hero .staff-fx{left:0;right:auto}
.bstage .hero .act.channel .staff-fx,.bstage .hero .act.cast .staff-fx{display:block}
.bstage .hero .staff-fx svg{width:100%;height:100%;overflow:visible}
.bstage .hero .staff-aura{fill:rgba(126,211,255,.45);stroke:#e9fbff;stroke-width:1.6;filter:drop-shadow(0 0 4px #58baff);animation:b-staff-aura .42s ease-in-out infinite alternate}
.bstage .hero .staff-rune,.bstage .hero .staff-rays{fill:none;stroke:#bfeaff;stroke-width:1.1;opacity:0;filter:drop-shadow(0 0 3px #49aaff);transform-box:view-box;transform-origin:92px 7px}
.bstage .hero .act.channel .staff-rune,.bstage .hero .act.channel .staff-rays{opacity:.85;animation:b-staff-rune .42s linear infinite}
.bstage .hero .act.cast .staff-rune,.bstage .hero .act.cast .staff-rays{animation:b-staff-release .5s ease-out both}
.bstage .act.cast{animation:b-cast calc(var(--d,1)*.5s) cubic-bezier(.2,.8,.3,1)}
.bstage .act.mcast{animation:b-mcast calc(var(--d,1)*.86s) ease-in-out}
.bstage .act.mlunge{animation-duration:calc(var(--d,1)*.56s)}
/* breathing: slight vertical squash + inverse horizontal stretch */
@keyframes b-breathe{0%,100%{transform:none}50%{transform:translateY(-1.2%) scale(1.006,1.014)}}
@keyframes b-cape{0%,100%{transform:skewX(0)}30%{transform:skewX(2.2deg)}65%{transform:skewX(-1.2deg)}}
/* sword: anticipation (crouch back) → dash in, lean → hit-stop hold → follow-through over-rotate → step back → settle */
@keyframes b-slash{0%{transform:none}14%{transform:translateX(-5%) scale(1.02,.96) rotate(-3deg)}36%{transform:translateX(var(--lx,120px)) rotate(7deg)}46%{transform:translateX(var(--lx,120px)) rotate(9deg)}
  58%{transform:translateX(calc(var(--lx,120px) + 6px)) rotate(-4deg)}80%{transform:translateX(-3%) rotate(-1deg)}100%{transform:none}}
/* knight shield bash: plant → shoulder charge (no rotation, low) → recoil */
@keyframes b-bash{0%{transform:none}16%{transform:translateX(-4%) scale(1.03,.95)}38%{transform:translateX(var(--lx,120px)) scale(1.04,.98)}50%{transform:translateX(calc(var(--lx,120px) - 8px))}78%{transform:translateX(-2%)}100%{transform:none}}
/* archer: draw back + lean → hold → release snap → recoil → settle */
@keyframes b-draw{0%{transform:none}28%{transform:translateX(-12px) rotate(-8deg) scale(.97,1.03)}43%{transform:translateX(-17px) rotate(-11deg) scale(.97,1.03)}51%{transform:translateX(-18px) rotate(-12deg)}62%{transform:translateX(15px) rotate(10deg) scale(1.03,.97)}76%{transform:translateX(-5px) rotate(-3deg)}100%{transform:none}}
@keyframes b-bowstring{0%,24%{opacity:0}40%,53%{opacity:1}66%,100%{opacity:0}}
@keyframes b-bow-arrow{0%,20%{opacity:0;transform:translateX(0)}38%{opacity:1;transform:translateX(-13px)}52%{opacity:1;transform:translateX(-15px)}62%{opacity:1;transform:translateX(17px)}78%{opacity:.85;transform:translateX(72px)}100%{opacity:0;transform:translateX(140px)}}
/* mage: channel (rise, lean back) → push forward cast → follow-through */
@keyframes b-channel{0%{transform:none}55%{transform:translateY(-12px) translateX(-10px) rotate(-9deg) scale(1.035)}100%{transform:translateY(-12px) translateX(-10px) rotate(-9deg) scale(1.035)}}
@keyframes b-cast{0%{transform:translateY(-12px) translateX(-10px) rotate(-9deg) scale(1.035)}22%{transform:translateY(-3px) translateX(22px) rotate(13deg) scale(1.05)}42%{transform:translateX(16px) rotate(8deg) scale(1.025)}68%{transform:translateX(-5px) rotate(-2deg)}100%{transform:none}}
@keyframes b-staff-aura{to{r:9;opacity:.45}}
@keyframes b-staff-rune{to{transform:rotate(180deg)}}
@keyframes b-staff-release{0%{opacity:.9;transform:scale(1)}35%{opacity:1;transform:scale(1.7)}100%{opacity:0;transform:scale(2.3)}}
/* monster spell: rear back + swell → release */
@keyframes b-mcast{0%{transform:none}45%{transform:translateX(5%) scale(1.06,1.04) rotate(3deg)}62%{transform:translateX(-6%) scale(.98,1.02) rotate(-3deg)}100%{transform:none}}
.bstage.rm .hero img.cape{animation:none}
.bstage.rm .act.slash,.bstage.rm .act.bash,.bstage.rm .act.draw,.bstage.rm .act.channel,.bstage.rm .act.cast,.bstage.rm .act.mcast{animation:none}
.bstage .tint.aura{animation:b-aura .8s ease-out}
@keyframes b-aura{0%{opacity:0}25%{opacity:.34}100%{opacity:0}}
.bstage.rm .tint.aura{animation:none}

/* v0.5.1 contrast: floating numbers / labels get a dark stroke + halo so they read on any painted background */
