@keyframes b-hero-sword{0%{transform:translateX(0) rotate(0)}28%{transform:translateX(-4px) rotate(-5deg)}58%{transform:translateX(12px) rotate(8deg)}76%{transform:translateX(8px) rotate(4deg)}100%{transform:translateX(0) rotate(0)}}
