  /** duel replay: both portraits, HP bars driven by the server's log (purely a playback of the settled result) */
  function pkReplay(p) {
    const lg = p.log || {}; const steps = lg.steps || []; const max = lg.max || { a: 1, b: 1 };
    const side = (x, k) => `<div class="pkf" id="pk_${k}"><img src="${artSrc('portrait', heroKey(x.baseClass, x.gender, x.classPath))}" alt=""><b>${esc(x.name)}</b><small>Lv.${x.level} ${esc(x.className || '')}</small>${bar('hp', max[k], max[k], `HP ${fmt(max[k])}`)}<div class="pkdmg"></div></div>`;
    const c = sheet(`<h2>⚔️ ${esc(p.a.name)} vs ${esc(p.b.name)}</h2><div class="pkarena">${side(p.a, 'a')}<div class="pkvs">VS</div>${side(p.b, 'b')}</div><div class="pkres muted" id="pkres">${p.rounds} 回合…</div><div class="row mt"><button class="btn ghost" data-skip>跳過</button><button class="btn" data-x>關閉</button></div>`);
    const hp = { a: max.a, b: max.b }; let i = 0; let tm = 0;
    const set = (k) => { const el = c.querySelector(`#pk_${k} .bar`); if (el) { el.querySelector('i').style.width = `${pct(hp[k], max[k])}%`; el.querySelector('b').textContent = `HP ${fmt(hp[k])}`; } };
    const finish = () => { clearTimeout(tm); if (lg.hp) { hp.a = lg.hp.a; hp.b = lg.hp.b; set('a'); set('b'); } const w = p.winner === 'a' ? p.a : p.b, l = p.winner === 'a' ? p.b : p.a;
      c.querySelector(`#pk_${p.winner}`).classList.add('win'); c.querySelector(`#pk_${p.winner === 'a' ? 'b' : 'a'}`).classList.add('lose');
      const r = c.querySelector('#pkres'); r.className = 'pkres'; r.innerHTML = `🏆 <b>${esc(w.name)}</b> 勝！${lg.ko ? `${p.rounds} 回合擊倒` : `${p.rounds} 回合判定`}<br>${p.drop ? `💥 ${esc(l.name)} 掉落【${esc(p.drop.name)}】→ ${esc(w.name)}（已解除綁定，可交易買回）` : p.wardUsed ? `🧿 ${esc(l.name)} 的守護符擋下了掉裝` : `${esc(l.name)} 沒有掉裝備`}`; };
    const step = () => { if (!c.isConnected || i >= steps.length) return finish(); const s = steps[i++]; const tgt = s.by === 'a' ? 'b' : 'a'; hp[tgt] = s.hp; set(tgt);
      const f = c.querySelector(`#pk_${tgt}`); const atk = c.querySelector(`#pk_${s.by}`); atk.classList.remove('hitme', 'atk'); f.classList.remove('hitme'); void f.offsetWidth; atk.classList.add('atk'); f.classList.add('hitme');
      const d = f.querySelector('.pkdmg'); d.textContent = `${s.crit ? '💥' : ''}-${fmt(s.dmg)}`; d.className = `pkdmg on${s.crit ? ' crit' : ''}${s.skill ? ' skill' : ''}`;
      tm = setTimeout(step, matchMedia('(prefers-reduced-motion: reduce)').matches ? 120 : s.crit ? 700 : 480); };
    c.querySelector('[data-x]').onclick = () => { clearTimeout(tm); closeSheet(); }; c.querySelector('[data-skip]').onclick = () => { i = steps.length; finish(); };
    tm = setTimeout(step, 500);
  }
