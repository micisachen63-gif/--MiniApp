{
  "name": "star-journal-rpg-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Star Journal RPG (星穹旅誌) - Unified Monorepo (Worker + Cloud Bot + Local Bot)",
  "scripts": {
    "test:worker": "node scripts/run-tests.mjs worker",
    "test:bot": "node scripts/run-tests.mjs bot",
    "test": "node scripts/run-tests.mjs all",
    "sync:check": "node scripts/release-sync.mjs check all",
    "sync:check:worker": "node scripts/release-sync.mjs check worker",
    "sync:check:bot": "node scripts/release-sync.mjs check bot",
    "deploy:worker": "node scripts/deploy-locked.mjs worker",
    "deploy:bot": "node scripts/deploy-locked.mjs bot",
    "test:monsters": "node --test worker/test/monster-*.test.js",
    "monster:check": "node worker/tools/refresh-monster-catalog.mjs --check",
    "monster:review": "cd worker && node tools/build-monster-review-data.mjs"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "iztro": "2.6.2",
    "jpeg-js": "0.4.4",
    "lunar-javascript": "1.7.7"
  }
}
