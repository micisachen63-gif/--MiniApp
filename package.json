{
  "name": "star-journal-rpg-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Star Journal RPG (星穹旅誌) - Unified Monorepo (Worker + Cloud Bot + Local Bot)",
  "scripts": {
    "test:worker": "node --test worker/test/rules.test.js worker/test/api.test.js",
    "test:bot": "node --test cloud-bot/src/adapter/test/*.test.js",
    "test": "npm run test:worker && npm run test:bot",
    "sync:check": "node scripts/release-sync.mjs check all",
    "sync:check:worker": "node scripts/release-sync.mjs check worker",
    "sync:check:bot": "node scripts/release-sync.mjs check bot",
    "deploy:worker": "node scripts/release-sync.mjs deploy worker",
    "deploy:bot": "node scripts/release-sync.mjs deploy bot"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  }
}
